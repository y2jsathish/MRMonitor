{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft": "Warning", "System.Net.Http": "Warning" } },

  "Agent": {
    "AtmCode": "REPLACE-WITH-ATM-CODE",
    "GatewayBaseUrl": "https://nexus-gw.example.bank",
    "CachePath": "C:\\ProgramData\\ATMNexus\\agent-cache.db",
    "DevicePollInterval": "00:00:30",
    "HealthInterval": "00:01:00",
    "TelemetryInterval": "00:01:00",
    "Services": [
      { "Name": "REPLACE-ATM-APP-SERVICE", "Role": "AtmApp", "Critical": true, "AutoRestart": true, "MaxAutoRestartsPerHour": 2 },
      { "Name": "REPLACE-XFS-MANAGER-SERVICE", "Role": "Xfs", "Critical": true, "AutoRestart": false }
    ],
    "Processes": []
  },

  "Security": {
    "ClientCertThumbprint": "",
    "TokenEndpoint": "https://nexus-idp.example.bank/connect/token",
    "Scope": "atm.agent"
  },

  "Xfs": {
    "Api": { "AppId": "ATMNexusAgent", "LowVersion": 3, "HighVersion": 3 },
    "Manager": { "MaxInfoAttempts": 3 }
  },

  "DeviceManager": {
    "AutoDiscover": true,
    "StatusTimeout": "00:00:20",
    "Devices": [
      { "LogicalName": "CashDispenser", "Class": "CashDispenser", "Vendor": "NCR", "Adapter": "xfs3",
        "Settings": { "AllowDispense": "false" } },
      { "LogicalName": "NCRCDM4IoT", "Class": "CashDispenser", "Vendor": "NCR", "Adapter": "xfs4iot",
        "Endpoint": "wss://localhost:5846/xfs4iot/v1.0" }
    ]
  },

  "Health": { "HealthyAt": 85, "DegradedAt": 60, "CriticalAt": 30 },
  "Alarms": { "DedupWindow": "00:05:00", "FlapThreshold": 6, "FlapWindow": "00:10:00" },

  "Commands": {
    "AtmCode": "REPLACE-WITH-ATM-CODE",
    "TrustedKeys": { "cmd-2025-01": "REPLACE-BASE64-SPKI-OF-COMMAND-SIGNING-KEY" },
    "Enabled": [ "RestartApplication", "RestartXfs", "RestartDevice", "RestartWindowsService", "CollectLogs", "CollectEj", "RunDiagnostics", "RebootAtm" ],
    "RequireApproval": [ "RebootAtm", "ShutdownAtm" ],
    "AllowedServices": [],
    "AtmApplicationService": "REPLACE-ATM-APP-SERVICE",
    "XfsServiceName": "REPLACE-XFS-MANAGER-SERVICE",
    "LogDirectories": [ "C:\\ProgramData\\ATMNexus\\logs" ]
  },

  "Ej": {
    "AtmTimeZoneId": "UTC",
    "Interval": "00:01:00",
    "Sources": [
      { "Name": "primary", "Vendor": "NCR", "Directory": "C:\\EJ", "FilePattern": "*.jrn", "Encoding": "utf-8" }
    ]
  },

  "ProBase": { "Enabled": false, "LogDirectory": "C:\\ProBase\\Log", "JournalDirectory": "C:\\ProBase\\Journal" },

  "Otel": { "Enabled": false }
}
