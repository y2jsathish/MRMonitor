{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=atmnexus;Username=atmnexus_app;Password=__from-secret-store__;Maximum Pool Size=100;Pooling=true;SSL Mode=Prefer"
  },
  "Auth": { "Authority": "https://nexus-idp.example.bank", "Audience": "atmnexus-api" },
  "Kafka": { "BootstrapServers": "localhost:9092", "SecurityProtocol": "Plaintext" },
  "CommandSigning": { "KeyId": "cmd-2025-01", "PrivateKeyPemPath": "/secrets/command-signing/private.pem" },
  "OfflineDetector": { "OfflineAfter": "00:03:00", "Interval": "00:00:30" },
  "LogStore": { "Directory": "/var/atmnexus/logs" }
}
