{
  "index_patterns": ["atm-ej-*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 6,
      "number_of_replicas": 1,
      "index.lifecycle.name": "atm-ej-policy",
      "index.codec": "best_compression",
      "index.mapping.total_fields.limit": 200
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "atm_code":        { "type": "keyword" },
        "vendor":          { "type": "keyword" },
        "type":            { "type": "keyword" },
        "start":           { "type": "date" },
        "end":             { "type": "date" },
        "masked_pan":      { "type": "keyword" },
        "amount":          { "type": "scaled_float", "scaling_factor": 100 },
        "currency":        { "type": "keyword" },
        "outcome":         { "type": "keyword" },
        "error_codes":     { "type": "keyword" },
        "notes_presented": { "type": "keyword" },
        "file":            { "type": "keyword" },
        "lines":           { "type": "text", "norms": false },
        "indexed_at":      { "type": "date" }
      }
    }
  },
  "_meta": { "description": "ATM Nexus electronic journal. PAN is masked BIN6+last4 by the agent; strict mapping rejects accidental new fields." }
}
