{
  "policy": {
    "phases": {
      "hot":    { "actions": { "rollover": { "max_age": "30d", "max_primary_shard_size": "40gb" } } },
      "warm":   { "min_age": "30d",  "actions": { "forcemerge": { "max_num_segments": 1 }, "shrink": { "number_of_shards": 1 } } },
      "cold":   { "min_age": "180d", "actions": { "searchable_snapshot": { "snapshot_repository": "atmnexus-snapshots" } } },
      "delete": { "min_age": "400d", "actions": { "delete": {} } }
    }
  }
}
